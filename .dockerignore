# flyctl launch added from backend/.gitignore
backend/**/__pycache__
backend/**/*.pyc
backend/**/.venv
backend/**/governance.db
backend/**/*.db
backend/**/ensemble.pt
backend/**/.pytest_cache
backend/**/.ruff_cache

backend/**/environment:
backend/**/  - ENV=prod
backend/**/  - JWT_SECRET=${JWT_SECRET} 

# flyctl launch added from backend/.pytest_cache/.gitignore
# Created by pytest automatically.
backend/.pytest_cache/**/*

# flyctl launch added from backend/test/.pytest_cache/.gitignore
# Created by pytest automatically.
backend/test/.pytest_cache/**/*

# flyctl launch added from frontend/.gitignore
# Logs
frontend/**/logs
frontend/**/*.log
frontend/**/npm-debug.log*
frontend/**/yarn-debug.log*
frontend/**/yarn-error.log*
frontend/**/pnpm-debug.log*
frontend/**/lerna-debug.log*

frontend/**/node_modules
frontend/**/dist
frontend/**/dist-ssr
frontend/**/*.local

# Editor directories and files
frontend/**/.vscode/*
!frontend/**/.vscode/extensions.json
frontend/**/.idea
frontend/**/.DS_Store
frontend/**/*.suo
frontend/**/*.ntvs*
frontend/**/*.njsproj
frontend/**/*.sln
frontend/**/*.sw?
fly.toml
